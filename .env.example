# Copia este fichero a .env y rellena los valores. Nunca subas .env a Git.

# Proveedor de IA: mock (por defecto, sin red) | hf (Hugging Face)
AI_PROVIDER=mock

# Token de Hugging Face (https://huggingface.co/settings/tokens). Solo si AI_PROVIDER=hf.
HF_TOKEN=

# Modelos de Hugging Face (opcionales; estos son los valores por defecto)
# HF_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
# HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directorio base de datos y artefactos (por defecto, la raíz del proyecto)
# AIRBNB_PRICE_HOME=
